# Thread Node Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=production
APP_NAME=thread-node
APP_VERSION=1.0.0

# =============================================================================
# Security (CHANGE THESE IN PRODUCTION!)
# =============================================================================
JWT_SECRET=change-this-to-a-long-random-string
POSTGRES_PASSWORD=change-this-secure-postgres-password
REDIS_PASSWORD=change-this-secure-redis-password

# =============================================================================
# Backend API
# =============================================================================
API_PORT=8000
API_HOST=0.0.0.0

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=threadnode
POSTGRES_USER=thread
DATABASE_URL=postgresql://thread:${POSTGRES_PASSWORD}@postgres:5432/threadnode

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# OLLAMA Configuration
# =============================================================================
OLLAMA_DEFAULT_INSTANCE=http://ollama:11434

# Multiple instances (comma-separated)
OLLAMA_INSTANCES=http://ollama:11434
OLLAMA_INSTANCE_NAMES=Local
OLLAMA_INSTANCE_PRIORITIES=100

# Default models per node type
OLLAMA_ARCHITECT_MODEL=llama3:70b
OLLAMA_BROKER_MODEL=mistral:7b
OLLAMA_WORKER_MODEL=codellama:13b
OLLAMA_VALIDATOR_MODEL=llama3:70b

# =============================================================================
# A2A Protocol Configuration
# =============================================================================
A2A_PROTOCOL_VERSION=0.3
A2A_MAX_MESSAGE_SIZE=10485760
A2A_TIMEOUT_MS=30000
A2A_MAX_RETRIES=3

# =============================================================================
# Frontend Configuration
# =============================================================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# OpenAI Configuration (alternative to OLLAMA)
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (local - for frontend direct access)
REACT_APP_OLLAMA_URL=http://localhost:11434

# LM Studio Configuration (local)
REACT_APP_LMSTUDIO_URL=http://localhost:1234

# =============================================================================
# Security & CORS
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/app/logs/thread-node.log

# =============================================================================
# GPU Support (Optional - uncomment if using NVIDIA GPU)
# =============================================================================
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=compute,utility

# =============================================================================
# Monitoring (Optional)
# =============================================================================
# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090

# =============================================================================
# Performance Tuning
# =============================================================================
MAX_WORKERS=4
WORKER_TIMEOUT=300
MAX_CONCURRENT_TASKS=50

# =============================================================================
# Development Settings (uncomment for development)
# =============================================================================
# NODE_ENV=development
# DEBUG=thread-node:*
# CHOKIDAR_USEPOLLING=true